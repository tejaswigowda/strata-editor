{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strataeditor.dev/schemas/render.schema.json",
  "title": "render.json (Strata publish set, version 1)",
  "type": "object",
  "required": ["version", "scene", "render", "outputs", "checks"],
  "properties": {
    "version": { "const": 1 },
    "scene": {
      "type": "object",
      "required": ["repo", "file", "branch", "commit", "hash"],
      "properties": {
        "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "file": { "type": "string", "minLength": 1 },
        "branch": { "type": "string", "minLength": 1 },
        "commit": { "type": ["string", "null"], "pattern": "^[0-9a-f]{7,40}$" },
        "hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "render": {
      "type": "object",
      "required": ["mode", "deterministic", "renderer", "device", "fps", "frames", "frame_range", "duration_s", "width", "height", "seed", "exporter", "rendered_at"],
      "properties": {
        "mode": { "enum": ["offline", "realtime"] },
        "deterministic": { "type": "boolean", "description": "Temporal determinism only; true only when mode is offline and the time-source audit passed. Never a claim about pixels." },
        "renderer": { "type": "string" },
        "device": { "type": "string" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "frames": { "type": "integer", "minimum": 1 },
        "frame_range": { "type": "array", "items": { "type": "integer", "minimum": 0 }, "minItems": 2, "maxItems": 2 },
        "duration_s": { "type": "number", "exclusiveMinimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "seed": { "type": ["number", "null"] },
        "exporter": { "type": "string" },
        "rendered_at": { "type": "string", "format": "date-time" },
        "time_source_audit": { "type": "object", "description": "Present when deterministic is true." }
      }
    },
    "outputs": {
      "type": "object",
      "required": ["master", "renditions", "poster", "captions"],
      "properties": {
        "master": { "const": "master.m3u8" },
        "renditions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "width", "height", "bitrate_kbps", "playlist", "segments", "max_segment_bytes"],
            "properties": {
              "name": { "type": "string" }, "width": { "type": "integer" }, "height": { "type": "integer" },
              "bitrate_kbps": { "type": "number" }, "playlist": { "type": "string" },
              "segments": { "type": "integer", "minimum": 1 }, "max_segment_bytes": { "type": "integer", "minimum": 0 }
            }
          }
        },
        "poster": { "type": "string" },
        "captions": { "type": ["string", "null"] }
      }
    },
    "checks": {
      "type": "object",
      "required": ["segments_under_20mb", "files_under_100mb", "frame_count_matches_duration"],
      "properties": {
        "segments_under_20mb": { "type": "boolean" },
        "files_under_100mb": { "type": "boolean" },
        "frame_count_matches_duration": { "type": "boolean" }
      }
    }
  }
}
