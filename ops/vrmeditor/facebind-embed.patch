+      g.add(mesh(new THREE.CylinderGeometry(0.16, 0.16, 0.008, 40), mat(c, 0.5), 0, 0.226, -0.012))
+      g.add(mesh(new THREE.CylinderGeometry(0.1, 0.1, 0.03, 36, 1, true), mat('#b02a3a', 0.6), 0, 0.245, -0.012))
+      return g
+    }
+  },
