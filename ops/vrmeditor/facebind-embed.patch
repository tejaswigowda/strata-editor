+    id: 'cat-ears', label: 'Cat ears', icon: '🐱', bone: 'head', color: '#f4a8c8', build: c => {
+      const g = new THREE.Group(); const band = mat('#222222')
+      g.add(mesh(new THREE.TorusGeometry(0.118, 0.005, 8, 40, Math.PI), band, 0, 0.1, -0.012, 0, 0, 0))
+      for (const s of [-1, 1]) {
+        g.add(mesh(new THREE.ConeGeometry(0.036, 0.075, 3), mat(c), s * 0.072, 0.232, -0.01, 0, 0, -s * 0.32))
+        g.add(mesh(new THREE.ConeGeometry(0.022, 0.05, 3), mat('#ffd7e6'), s * 0.07, 0.228, -0.003, 0, 0, -s * 0.32))
+      }
+      return g
+    }
+  },
+  {
+    id: 'bunny-ears', label: 'Bunny ears', icon: '🐰', bone: 'head', color: '#ffffff', build: c => {
+      const g = new THREE.Group()
+      g.add(mesh(new THREE.TorusGeometry(0.118, 0.005, 8, 40, Math.PI), mat('#dddddd'), 0, 0.1, -0.012))
+      for (const s of [-1, 1]) {
+        const e = mesh(new THREE.CapsuleGeometry(0.026, 0.12, 6, 16), mat(c), s * 0.055, 0.31, -0.01, 0, 0, -s * 0.16); e.scale.set(1, 1, 0.55)
+        g.add(e)
+        const i = mesh(new THREE.CapsuleGeometry(0.014, 0.09, 6, 12), mat('#ffb6cb'), s * 0.055, 0.31, 0.003, 0, 0, -s * 0.16); i.scale.set(1, 1, 0.4)
+        g.add(i)
+      }
+      return g
+    }
+  },
+  {
+    id: 'headband', label: 'Headband', icon: '🎀', bone: 'head', color: '#e0415a', build: c => {
+      const g = new THREE.Group()
+      const b = mesh(new THREE.TorusGeometry(0.118, 0.008, 8, 48), mat(c), 0, 0.15, -0.012, Math.PI / 2, 0, 0)
+      b.scale.set(1, 1.07, 1.4)
+      g.add(b)
+      return g
+    }
+  },
+  {
+    id: 'crown', label: 'Crown', icon: '👑', bone: 'head', color: '#f2c230', build: c => {
+      const g = new THREE.Group(); const m = mat(c, 0.25, 0.8)
+      g.add(mesh(new THREE.CylinderGeometry(0.1, 0.1, 0.035, 32, 1, true), m, 0, 0.225, -0.012))
+      for (let i = 0; i < 6; i++) {
+        const a = (i / 6) * Math.PI * 2
+        g.add(mesh(new THREE.ConeGeometry(0.014, 0.05, 6), m, Math.sin(a) * 0.1, 0.268, -0.012 + Math.cos(a) * 0.1))
+        g.add(mesh(new THREE.SphereGeometry(0.007, 10, 8), mat('#d4233a', 0.2), Math.sin(a) * 0.1, 0.298, -0.012 + Math.cos(a) * 0.1))
+      }
+      return g
+    }
+  },
+  {
+    id: 'halo', label: 'Halo', icon: '😇', bone: 'head', color: '#ffe27a', build: c => {
+      const m = new THREE.MeshStandardMaterial({ color: c, emissive: c, emissiveIntensity: 0.6, roughness: 0.3, metalness: 0.4 })
+      return mesh(new THREE.TorusGeometry(0.08, 0.006, 10, 48), m, 0, 0.34, -0.012, Math.PI / 2)
+    }
+  },
+  {
+    id: 'bow-tie', label: 'Bow tie', icon: '🎀', bone: 'neck', color: '#b02a3a', build: c => {
+      const g = new THREE.Group(); const m = mat(c)
+      for (const s of [-1, 1]) g.add(mesh(new THREE.ConeGeometry(0.026, 0.042, 4), m, s * 0.026, -0.015, 0.058, 0, 0, s * Math.PI / 2))
+      g.add(mesh(new THREE.SphereGeometry(0.01, 12, 10), m, 0, -0.015, 0.06))
+      return g
+    }
+  },
+]
+
+/** Builds the GLB bytes for one accessory. */
+export function buildFreeAccessory(id: string, colorHex?: string): Promise<{ name: string; buffer: ArrayBuffer; def: FreeAccessoryDef }> {
+  const def = FREE_ACCESSORIES.find(a => a.id === id)
+  if (!def) return Promise.reject(new Error('unknown accessory ' + id))
+  const root = def.build(new THREE.Color(colorHex || def.color))
+  const scene = new THREE.Scene()
+  scene.add(root)
+  return new Promise((resolve, reject) => {
+    new GLTFExporter().parse(scene, (r: any) => r instanceof ArrayBuffer ? resolve({ name: def.id + '.glb', buffer: r, def }) : reject(new Error('GLB export did not return binary')), reject, { binary: true })
+  })
+}
